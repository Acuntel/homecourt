# HOMECOURT — environment template.
# In M2 the Supabase stack runs LOCALLY via `pnpm db:start` (Docker). The
# values below mirror what `supabase status` prints; copy them into
# apps/web/.env.local. A remote staging/prod project is provisioned later.

# Supabase (local stack defaults — change for staging / prod)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=http://127.0.0.1:54321
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Engine + worker
ENGINE_URL=http://localhost:8080
ENGINE_WS_URL=ws://localhost:8080/ws
NATS_URL=nats://localhost:4222

# App
NEXT_PUBLIC_BRAND=HOMECOURT
SWEEPSTAKES_STARTING_COINS=50000
NEXT_PUBLIC_RELEASE=dev
LOG_LEVEL=info

# Rate limiting (optional in dev — falls back to lru-cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Oracle worker tick
ORACLE_INTERVAL_MS=15000
